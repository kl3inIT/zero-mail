# =============================================================================
# Zero Mail — LOCAL DEV environment template.
#
# 3-person team workflow:
#   1. Copy this file to `.env.local` (gitignored).
#   2. Fill in TODO fields below.
#   3. Connect to the shared dev DB on the VPS via an SSH tunnel:
#        ssh -fN -L 5555:zeromail-postgres:5432 dat@72.62.193.33
#      Background it (`-fN`) so the tunnel stays up while you code.
#   4. Run the JVM via IntelliJ ZeroMailApi / ZeroMailWorker run configs,
#      or `docker compose -f docker-compose.yml -f docker-compose.override.yml up`
#      for a fully containerized local stack against a *local* Postgres + Redis.
#
# See docs/ops/DEV-ENV.md for the full setup walkthrough (SSH key, GCP OAuth
# dev client, Pub/Sub tunneling, Tailscale dev tunnel for Gmail push, etc.).
# =============================================================================

# ── Database (shared dev DB on the VPS, reached via SSH tunnel) ──────────────
# After `ssh -fN -L 5555:zeromail-postgres:5432 dat@72.62.193.33`, Postgres is
# at localhost:5555. Database `zeromail_dev`, role `zeromail_dev` — isolated
# from prod (role has no access to the `zeromail` DB).
# Password is shared out-of-band by the operator (NOT committed here).
DB_URL=jdbc:postgresql://localhost:5555/zeromail_dev
DB_USER=zeromail_dev
DB_PASSWORD=ASK_OPERATOR

# ── Redis (always local to your machine — DO NOT share Redis across devs) ────
# Session cookies, idempotency keys, and rate limits would race across team
# members on a shared Redis. Stay local.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Google OAuth (local-dev client) ──────────────────────────────────────────
# Recommend a single dev OAuth client registered with all team callback URIs:
#   http://localhost:8080/login/oauth2/code/google
#   https://<your-tailscale>.ts.net/login/oauth2/code/google   (if using tailscale serve)
# Operator paste client ID + secret out-of-band, NOT here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Encryption (AES-256-GCM for OAuth refresh tokens) ────────────────────────
# REQUIRED. Generate locally: `openssl rand -base64 32`.
# Each dev uses a DIFFERENT key locally — DO NOT share the prod key.
REFRESH_TOKEN_KEY_BASE64=
LOCAL_REFRESH_TOKEN_KEY_BASE64=

# ── Encryption (AES-256-GCM for Gmail inbox projection metadata) ─────────────
# REQUIRED. Generate locally: `openssl rand -base64 32`.
# Separate from REFRESH_TOKEN_KEY_BASE64 so OAuth tokens and mail metadata stay
# in different blast-radius compartments. Encrypts subject / snippet / sender
# email / sender display name on the gmail_inbox_projection table.
INBOX_PROJECTION_KEY_BASE64=

# ── HMAC key for deterministic sender lookup on the inbox projection ─────────
# REQUIRED. Generate locally: `openssl rand -base64 32`.
# Separate from INBOX_PROJECTION_KEY_BASE64 so a leak of the field encryption
# key cannot be used to recompute sender hashes (and vice versa).
INBOX_PROJECTION_SENDER_HASH_KEY_BASE64=

# ── LLM / AI (OpenRouter) ────────────────────────────────────────────────────
# Get a dev-only key at https://openrouter.ai/keys with a low monthly cap
# ($5–10) so dev experimentation can't blow through prod quota.
ZEROMAIL_LLM_PLATFORM_API_KEY=

# ── Gmail Pub/Sub push ingress (for testing Gmail-watch flows locally) ───────
# Local dev typically funnels Gmail push to localhost via Tailscale Funnel.
# Run `pnpm tailscale:funnel:api` then put the resulting *.ts.net URL here.
PUBSUB_PUSH_AUDIENCE_URL=https://YOUR-NAME.taild3b6dc.ts.net/internal/pubsub/gmail
PUBSUB_SA_PRINCIPAL_EMAIL=pubsub-push@zero-mail-494515.iam.gserviceaccount.com
PUBSUB_OIDC_CERTIFICATES_URL=https://www.googleapis.com/oauth2/v3/certs
# Each dev points at their own dev subscription topic so push notifications
# don't fan out to other devs.
GOOGLE_PUBSUB_TOPIC_NAME=projects/zero-mail-494515/topics/gmail-notifications-dev

# ── Web / CORS / session (localhost defaults) ────────────────────────────────
ZEROMAIL_WEB_BASE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
ZEROMAIL_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174
ZEROMAIL_CORS_ALLOW_CREDENTIALS=true
# Plain HTTP locally → cookie cannot be Secure or browsers drop it.
ZEROMAIL_SESSION_COOKIE_SECURE=false
SERVER_FORWARD_HEADERS_STRATEGY=framework
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=lax

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8080
API_SPEC_URL=http://localhost:8080/v3/api-docs

# ── Notification (Resend) ────────────────────────────────────────────────────
# Use a dev-only key OR leave as a placeholder if you're not testing outbound mail.
RESEND_API_KEY=re_placeholder

# Lemon Squeezy one-time plan upgrade checkout. Checkout creation calls the
# Lemon Squeezy API and requires STORE_ID + API_KEY + plan variant IDs in DB.
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SIGNING_SECRET=
LEMON_SQUEEZY_TEST_MODE=true
# Optional override for tests/proxies; leave default for normal Lemon Squeezy.
LEMON_SQUEEZY_API_BASE_URL=https://api.lemonsqueezy.com/v1
LEMON_SQUEEZY_CHECKOUT_REUSE_WINDOW=PT15M

# ── Admin console (Phase 8) ──────────────────────────────────────────────────
# Your own dev gmail goes here so you receive the admin enrollment URL on boot.
ZEROMAIL_ADMIN_BOOTSTRAP_EMAILS=
# Generate locally: `openssl rand -base64 32`. Per-dev key.
ZEROMAIL_ADMIN_AUDIT_HMAC_KEK_BASE64=
ZEROMAIL_ADMIN_WEBAUTHN_RP_ID=localhost
ZEROMAIL_ADMIN_WEBAUTHN_RP_NAME="Zero Mail Admin Dev"
ZEROMAIL_ADMIN_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5174

# ── Compose / Spring lifecycle toggles ───────────────────────────────────────
# IntelliJ run configurations set this to false (compose lifecycle is operator-driven).
SPRING_DOCKER_COMPOSE_ENABLED=false

# ── Logging (extra verbose for dev) ─────────────────────────────────────────
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG

# ── GCP toggles (no GCP hosting baseline — keep disabled) ───────────────────
GCP_SECRET_MANAGER_ENABLED=false
GCP_CORE_ENABLED=false

# ── Image overrides — leave empty for local builds; deploy workflows fill these ──
ZEROMAIL_API_IMAGE=
ZEROMAIL_WORKER_IMAGE=
ZEROMAIL_FRONTEND_IMAGE=
