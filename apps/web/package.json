{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "pnpm i18n:build && next build",
    "start": "next start",
    "lint": "eslint",
    "generate:api": "tsx scripts/generate-api.ts",
    "i18n:build": "tsx scripts/merge-feature-i18n.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "pnpm test:e2e",
    "test:e2e": "node ../../node_modules/@playwright/test/cli.js test",
    "test:e2e:golden": "playwright test --config=playwright.golden.config.ts launch-golden-path.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "next-intl": "^4.11.1",
    "next-mdx-remote": "6.0.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "5.100.9",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vitest": "4.1.5"
  }
}
