{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "pnpm i18n:build && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "generate:api": "tsx scripts/generate-api.ts",
    "i18n:build": "tsx scripts/merge-feature-i18n.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
