    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "e2e": "pnpm test:e2e",
    "test:e2e": "node ../../node_modules/@playwright/test/cli.js test",
    "test:e2e:golden": "playwright test --config=playwright.golden.config.ts launch-golden-path.spec.ts",
    "doctor": "npx react-doctor@latest"
  },
