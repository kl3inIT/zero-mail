# Standalone 9router deployment — copy to .env, fill secrets, then:
#   cd apps/9router && docker compose up -d
#
# Admin UI exposed on loopback only. Access via SSH tunnel:
#   ssh -L 20128:127.0.0.1:20128 dat@72.62.193.33
#   → http://localhost:20128

# JWT signing key — generate: openssl rand -base64 32
ZEROMAIL_9ROUTER_JWT_SECRET=

# Initial admin password (applied on first boot of the data volume).
# Rotate via the admin UI AFTER first login. Generate: openssl rand -base64 24
ZEROMAIL_9ROUTER_INITIAL_PASSWORD=
