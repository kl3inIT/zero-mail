# Copy these values into the production .env or pass this file with
# `docker compose --env-file deploy/compose/.env.observability`.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-prod
GRAFANA_ROOT_URL=https://grafana.zeromail.vn

# 2026-06 pins. Re-test before bumping; digest pins are preferred for prod.
GRAFANA_IMAGE=grafana/grafana:13.0.1
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
LOKI_IMAGE=grafana/loki:3.7.2
TEMPO_IMAGE=grafana/tempo:2.10.5
ALLOY_IMAGE=grafana/alloy:v1.16.1
NODE_EXPORTER_IMAGE=prom/node-exporter:latest
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:latest
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:latest
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:latest

ZERO_MAIL_DEPLOYMENT_ENVIRONMENT=production
ZERO_MAIL_RELEASE_VERSION=manual
ZERO_MAIL_TRACING_ENABLED=true
ZERO_MAIL_OTLP_TRACING_ENABLED=true
ZERO_MAIL_TRACE_SAMPLING_PROBABILITY=0.10
ZERO_MAIL_OTLP_TRACES_ENDPOINT=http://zeromail-alloy:4318/v1/traces

PROMETHEUS_RETENTION_TIME=14d
PROMETHEUS_RETENTION_SIZE=8GB

# Set these to existing docker volume names when migrating from the old root compose.
POSTGRES_VOLUME_NAME=zero-mail_postgres_data
REDIS_VOLUME_NAME=zero-mail_redis_data
GRAFANA_VOLUME_NAME=zeromail_grafana_data
PROMETHEUS_VOLUME_NAME=zeromail_prometheus_data
LOKI_VOLUME_NAME=zeromail_loki_data
TEMPO_VOLUME_NAME=zeromail_tempo_data
ALLOY_VOLUME_NAME=zeromail_alloy_data

# Local-only operator ports. Public Grafana access should go through NPM + auth.
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALLOY_PORT=12345
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317
