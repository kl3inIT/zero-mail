<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      SensitiveMarkerScrubFilter is per-event (operates on ILoggingEvent), NOT a TurboFilter.
      A TurboFilter that stamped MDC made the marker thread-sticky and produced false
      audit signals on subsequent clean events. As an appender filter, the marker is
      attached only to the offending event's own MDC snapshot.
      It also redacts common LLM/API secret spellings before appenders encode output:
      apiKey=...
      Bearer ...
      x-api-key: ...
    -->

    <springProfile name="!prod &amp; !production">
        <appender name="DEV_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <filter class="com.zeromail.core.shared.privacy.SensitiveMarkerScrubFilter"/>
            <encoder>
                <pattern>${CONSOLE_LOG_PATTERN}</pattern>
                <charset>${CONSOLE_LOG_CHARSET}</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="DEV_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod | production">
        <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <filter class="com.zeromail.core.shared.privacy.SensitiveMarkerScrubFilter"/>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>scrubbed</includeMdcKeyName>
                <includeMdcKeyName>scrub_reason</includeMdcKeyName>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>trace_id</includeMdcKeyName>
                <includeMdcKeyName>span_id</includeMdcKeyName>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_STDOUT"/>
        </root>
    </springProfile>
</configuration>
