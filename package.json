{
  "name": "zero-mail",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.0.8"
  },
  "scripts": {
    "encoding:check": "node scripts/check-encoding.mjs",
    "check": "pnpm encoding:check && turbo run typecheck lint i18n:check",
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "web:dev": "pnpm --filter web dev",
    "web:dev:tailscale": "pnpm run tailscale:serve:web && pnpm run web:dev",
    "web:build": "pnpm --filter web build",
    "generate:api": "turbo run generate:api",
    "tailscale:serve:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-tailscale.ps1 -Mode serve -Target 3000",
    "tailscale:serve:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-tailscale.ps1 -Mode serve -Target 8080",
    "tailscale:funnel:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-tailscale.ps1 -Mode funnel -Target 3000",
    "tailscale:funnel:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-tailscale.ps1 -Mode funnel -Target 8080",
    "tailscale:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-tailscale.ps1 -Mode status",
    "tailscale:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-tailscale.ps1 -Mode reset",
    "prepare": "husky",
    "doctor": "npx react-doctor@latest"
  },
  "lint-staged": {
    "*": "pnpm encoding:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "react-doctor": "^0.5.5",
    "turbo": "2.9.18"
  },
  "pnpm": {
    "_comment": "Overrides + peerDependencyRules moved to pnpm-workspace.yaml in pnpm v11. This block kept for older tooling compatibility only — pnpm itself reads pnpm-workspace.yaml."
  }
}
