{
  "mcpServers": {
    "playwright-test": {
      "command": "node",
      "args": [
        "node_modules/playwright/cli.js",
        "run-test-mcp-server",
        "--headless"
      ]
    },
    "postgres": {
      "type": "stdio",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/mcp/postgres-mcp.ps1"
      ]
    }
  }
}