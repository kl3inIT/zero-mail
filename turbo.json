{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@zeromail/admin#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@zeromail/admin#test": {
      "dependsOn": [],
      "outputs": []
    },
    "@zeromail/admin#e2e": {
      "dependsOn": ["@zeromail/admin#build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:api": {
      "outputs": ["lib/api/schema.d.ts"]
    }
  }
}
