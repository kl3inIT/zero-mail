{
  "id": null,
  "uid": "zeromail-logs",
  "title": "Zero Mail — Logs (Loki)",
  "tags": ["zeromail", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "container", "stream": "", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "ALL,INFO,WARN,ERROR",
        "includeAll": false,
        "current": { "text": "ALL", "value": "ALL" },
        "options": [
          { "text": "ALL", "value": "ALL", "selected": true },
          { "text": "INFO", "value": "INFO" },
          { "text": "WARN", "value": "WARN" },
          { "text": "ERROR", "value": "ERROR" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by container",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } } } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (container) (count_over_time({container=~\"$container\"} [1m]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error/Warn rate",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (container) (count_over_time({container=~\"$container\"} |~ `(?i)\\\"level\\\":\\\"(ERROR|WARN)` [1m]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 14 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\"}",
          "legendFormat": ""
        }
      ]
    }
  ]
}
